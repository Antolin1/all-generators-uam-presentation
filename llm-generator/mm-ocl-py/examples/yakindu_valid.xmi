<?xml version='1.0' encoding='UTF-8'?>
<hu.bme.mit.inf.yakindumm:Statechart xmlns:xmi="http://www.omg.org/XMI" xmlns:hu.bme.mit.inf.yakindumm="hu.bme.mit.inf.yakindumm" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmi:version="2.0">
  <regions>
    <vertices xsi:type="hu.bme.mit.inf.yakindumm:Entry">
      <outgoingTransitions target="//@regions.0/@vertices.1"/>
    </vertices>
    <vertices xsi:type="hu.bme.mit.inf.yakindumm:State" incomingTransitions="//@regions.0/@vertices.0/@outgoingTransitions.0">
      <outgoingTransitions target="//@regions.0/@vertices.2"/>
    </vertices>
    <vertices xsi:type="hu.bme.mit.inf.yakindumm:Choice" incomingTransitions="//@regions.0/@vertices.1/@outgoingTransitions.0">
      <outgoingTransitions target="//@regions.0/@vertices.3"/>
      <outgoingTransitions target="//@regions.0/@vertices.4"/>
    </vertices>
    <vertices xsi:type="hu.bme.mit.inf.yakindumm:State" incomingTransitions="//@regions.0/@vertices.2/@outgoingTransitions.0">
      <outgoingTransitions target="//@regions.0/@vertices.5"/>
    </vertices>
    <vertices xsi:type="hu.bme.mit.inf.yakindumm:Exit" incomingTransitions="//@regions.0/@vertices.2/@outgoingTransitions.1"/>
    <vertices xsi:type="hu.bme.mit.inf.yakindumm:FinalState" incomingTransitions="//@regions.0/@vertices.3/@outgoingTransitions.0"/>
  </regions>
</hu.bme.mit.inf.yakindumm:Statechart>
