<?xml version='1.0' encoding='UTF-8'?>
<ecore:EPackage xmlns:xmi="http://www.omg.org/XMI" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="family" nsURI="http://mm-ocl-py/family" nsPrefix="family" xmi:version="2.0">
  <eClassifiers xsi:type="ecore:EClass" name="LivingBeing" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" eSuperTypes="#//LivingBeing" name="Person">
    <eStructuralFeatures xsi:type="ecore:EReference" name="children" eType="#//Person" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" eType="#//Person"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="pets" eType="#//Pet" upperBound="-1" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" eSuperTypes="#//LivingBeing" name="Pet">
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner" eType="#//Person"/>
  </eClassifiers>
</ecore:EPackage>
